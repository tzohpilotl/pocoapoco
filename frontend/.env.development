# Used by `npm run dev`. Points the SPA at the real Tracking Service running
# locally (NestJS on :3002), so local dev exercises the same backend code,
# auth, and Postgres schema as production — rather than the static json-server
# mock. See frontend/README.org ("Local development") for the full flow
# (start Postgres, run migrations, seed statuses, start the backend, then
# `/auth/test-login` to get a dev session).
#
# The json-server mock (`npm run mock-api`, mock/db.json) is still available as
# a lightweight fallback — point this at http://localhost:4000 to use it.
API_BASE_URL=http://localhost:3002
