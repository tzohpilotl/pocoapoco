# Used by compose.yaml to resolve the GHCR image (ghcr.io/<GITHUB_USERNAME>/pocoapoco-tracking-service:latest).
# Not needed for local dev — only read by `docker compose` on the server.
GITHUB_USERNAME=

# 3000 collides with tempo-app/backend's dev server, 8080 with loyalty-app-api's — picked 3002 to avoid both.
PORT=3002

DB_HOST=localhost
DB_PORT=5432
DB_USER=tracking_service
DB_PASSWORD=tracking_service
DB_NAME=tracking_service

SESSION_SECRET=

# Set to "production" on the server so the session cookie is sent cross-site
# (SameSite=None; Secure) and the app trusts Caddy's X-Forwarded-Proto.
NODE_ENV=

# Origin allowed to make credentialed requests (the deployed SPA). Defaults to
# the local esbuild dev server (http://localhost:5174) when unset.
FRONTEND_ORIGIN=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3002/auth/google/callback
